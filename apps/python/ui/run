#!/bin/bash
# Dev implementation script for UI server.

set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
repo_root="$script_dir"
while [[ "$repo_root" != "/" && ! -f "$repo_root/pyproject.toml" ]]; do
  repo_root="$(dirname "$repo_root")"
done
if [[ ! -f "$repo_root/pyproject.toml" ]]; then
  echo "FATAL: could not locate repository root (pyproject.toml not found)" >&2
  exit 1
fi

uv run dotenv -f "$repo_root/.env" run -- python -c "from ui.bootstrap import main; main()"
cd "$script_dir"
uv run dotenv -f "$repo_root/.env" run -- streamlit run app.py --browser.gatherUsageStats false "$@"
