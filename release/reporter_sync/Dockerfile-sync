FROM python:3.14-alpine AS builder

RUN apk add --no-cache git build-base

COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

ENV REPORTER_HOME=/opt/reporter
WORKDIR $REPORTER_HOME

COPY pyproject.toml uv.lock ./
COPY release/common/security.sh ./security.sh
COPY administration/ administration/
COPY bin/ bin/
COPY lib/ lib/
COPY sync_server/ sync_server/

ENV UV_LINK_MODE=copy
ENV PYTHONDONTWRITEBYTECODE=1
ENV UV_CACHE_DIR=/tmp/uv-cache

RUN uv sync --frozen --no-dev --no-editable \
    && sh ./security.sh \
    && rm -rf /tmp/uv-cache

FROM python:3.14-alpine

RUN apk add --no-cache bash libpq

ENV REPORTER_HOME=/opt/reporter
ENV PYTHONDONTWRITEBYTECODE=1
ENV PATH="$REPORTER_HOME/.venv/bin:$PATH"
WORKDIR $REPORTER_HOME

COPY --from=builder $REPORTER_HOME $REPORTER_HOME

RUN ln -s $REPORTER_HOME/bin/prod/sync /usr/local/bin/reporter-sync

CMD ["reporter-sync", "--no-dotenv"]
