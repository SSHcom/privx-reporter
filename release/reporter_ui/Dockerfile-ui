FROM python:3.14-slim AS builder

RUN apt-get update && apt-get install -y --no-install-recommends git && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

ENV REPORTER_HOME=/opt/reporter
WORKDIR $REPORTER_HOME

COPY pyproject.toml uv.lock ./
COPY administration/ administration/
COPY bin/ bin/
COPY lib/ lib/
COPY reports/ reports/
COPY ui/ ui/
COPY release/reporter_ui/certs/ certs/

ENV UV_LINK_MODE=copy
ENV PYTHONDONTWRITEBYTECODE=1
ENV UV_CACHE_DIR=/tmp/uv-cache

RUN uv sync --frozen --no-dev --no-editable \
    && rm -rf /tmp/uv-cache

FROM python:3.14-slim

ENV REPORTER_HOME=/opt/reporter
ENV PYTHONDONTWRITEBYTECODE=1
ENV PATH="$REPORTER_HOME/.venv/bin:$PATH"
WORKDIR $REPORTER_HOME

COPY --from=builder $REPORTER_HOME $REPORTER_HOME

RUN ln -s $REPORTER_HOME/bin/prod/ui /usr/local/bin/reporter-ui

CMD ["reporter-ui", "--no-dotenv"]
