DB_DATA_HOST=localhost
DB_DATA_PORT=5454 # External/host-mapped port in containerized setups
DB_DATA_USER=postgres
DB_DATA_PASSWORD=postgres
DB_DATA_NAME=report_data
DB_DATA_SSL_MODE=on

DB_ADMIN_HOST=localhost
DB_ADMIN_PORT=5455 # External/host-mapped port in containerized setups
DB_ADMIN_USER=postgres
DB_ADMIN_PASSWORD=postgres
DB_ADMIN_NAME=report_admin
DB_ADMIN_SSL_MODE=on

# A sync window is a date-time range.
#
# When querying the PrivX API, the first result will contain the number of records that are
# within the window. If the number of records is greater than the SYNC_MAX_RECORDS_PER_WINDOW,
# the window will be split into smaller windows.
#
# The aim is to grow the window size when the number of records is less than
# SYNC_MAX_RECORDS_PER_WINDOW, and shrink the window size when the number of records is greater.

# Window sizes in minutes when syncing data
SYNC_WINDOW_SIZES_MINUTES="8,12,16,20,24,28,32"

# Decrease step (minutes) when shrinking sync windows
SYNC_WINDOW_SIZE_DOWN_MINUTES=4
SYNC_MAX_RECORDS_PER_WINDOW=10000


# Max number of records per API call.
# If a window has 10000 records, 10 API calls will be made.
SYNC_BATCH_SIZE=1000 

# Sync behavior is defined by the interval, initial range, and retention.
#
# Interval:
#   How often the sync will happen. If this number is low, the sync action may take
#   longer than the interval, and the next sync will happen when the action is complete.
#
# Initial range:
#   The initial range of the sync. This is applied on the first sync (table is empty).
#
# Retention:
#   The retention of the sync. This is the number of days to keep the data in the database.

# Every 5 minutes, initial look-back window of 10 minutes, retention of 15 days
SYNC_CONNECTION=5,10,15
SYNC_AUDIT=5,10,15

# The sync range starts from the latest stored timestamp, but is limited to SYNC_MAX_RANGE_HOURS.
# If you need to sync older data, you can increase this value or use the admin CLI to backfill.
SYNC_MAX_RANGE_HOURS=2191

# Sources are synced in the order they are listed here
SYNC_SOURCES="trends,concurrent,connection,audit"

# "Trend" is a set of metrics. They are collected once a day at the specified hour (UTC 24-hour format).
SYNC_TREND_HOUR=1

# Max number of records per API call when fetching PrivX data through the API.
REPORT_API_BATCH_SIZE=500

# Directory where report output files are written. Using a full path is recommended.
REPORT_OUT_DIR=$HOME/REPORTS

# First-time admin password for the Reporter UI.
# Immediately change it after first login.
UI_TMP_ADMIN_PASSWORD=""

# JWT expiration time in minutes.
UI_JWT_EXPIRATION_MINUTES=60

# This maximum time the browser will keep the cookie alive.
UI_COOKIE_MAX_AGE_MINUTES=1440

# Enable session debug panel in own profile view.
UI_ENABLE_SESSION_DEBUG=false

# UI auth mode(s)
# UI_AUTH_MODE is a comma-separated list:
#
# - local: username+password, verified against a record in the admin database
#
# - <provider>: OIDC provider id. This will render a button on the login page
#               that will redirect to the provider's login page.
#
# Refer to OIDC specific guide for more information.
#
# Examples:
# UI_AUTH_MODE=local
# UI_AUTH_MODE=local,keycloak
# UI_AUTH_MODE=local,keycloak,entra
UI_AUTH_MODE=local

# PrivX API variables configure connection and authentication for reporter and sync components.
PRIVX_HOSTNAME=""
PRIVX_PORT=443
PRIVX_API_OAUTH_CLIENT_ID="privx-external"
PRIVX_API_OAUTH_CLIENT_SECRET=""
PRIVX_API_CLIENT_ID=""
PRIVX_API_CLIENT_SECRET=""

# Optional: PrivX trust anchor certificate. Leave empty to skip custom CA trust.
PRIVX_CA_CERT=""

# Database backup schedule (standalone installations only).
# Format: <enabled>,<target>,<interval-minutes>,<snapshots>
#   enabled:          true|false                  (default: true)
#   target:           admin|data|all              (default: all)
#   interval-minutes: dump frequency in minutes   (default: 720, minimum: 60)
#   snapshots:        dumps kept per database      (default: 5, minimum: 1)
BACKUP_CONFIG=true,all,720,5
BACKUP_DIR=/opt/reporter/.backup