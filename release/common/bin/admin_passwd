#!/bin/bash
set -euo pipefail

# Note: This script will only be used in production (Dockerfile)

if [[ -z "${REPORTER_HOME:-}" ]]; then
  echo "FATAL: REPORTER_HOME is not set" >&2
  exit 1
fi

cd "$REPORTER_HOME"
export PYTHONPATH="$REPORTER_HOME${PYTHONPATH:+:$PYTHONPATH}"

exec python -m lib._admin.passwd "$@"
